    {"id":"trigger","type":"conduit","position":{"x":50,"y":180},"data":{"kind":"trigger","nodeType":"schedule","label":"Monday at 09:00","description":"Weekly storage hygiene","config":{"schedule":"0 9 * * 1","catchUpMinutes":720}}},
